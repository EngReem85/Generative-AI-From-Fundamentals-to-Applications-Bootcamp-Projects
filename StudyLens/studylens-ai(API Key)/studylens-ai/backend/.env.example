# انسخ هذا الملف إلى .env في نفس المجلد، ثم ضع مفتاحك المجاني هنا.
# احصل على المفتاح مجاناً من: https://aistudio.google.com/apikey

GEMINI_API_KEY=ضع_مفتاحك_هنا

# اسم الموديل. إن ظهر خطأ بسبب تغيير الموديل مستقبلاً، غيّر القيمة هنا
# بعد مراجعة القائمة الحالية على: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash

# منفذ تشغيل الخادم المحلي (اختياري)
PORT=5000
